# 服务端口（Render 会自动注入 PORT，本地默认 3000）
PORT=3000

# Supabase 数据库连接串
# Dashboard → Project Settings → Database → Connection string → Session pooler / Transaction pooler
# 注意：需要保留 ?sslmode=require
DATABASE_URL=postgresql://postgres.xxxxxxxx:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT 签名密钥，上线前务必改成一串随机字符
JWT_SECRET=please-change-this-to-a-random-string

# 启动时自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_INITIAL_COINS=0
